  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 1,
      "title": "RepoGPT Telemetry & LLM Observability",
      "type": "row"
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "axisCenteredZero": false },
          "unit": "s"
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 1 },
      "id": 2,
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" }
      },
      "title": "LLM Request Latency (p50 / p95)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(repogpt_llm_latency_seconds_bucket[5m])) by (le))",
          "legendFormat": "p95 Latency",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.50, sum(rate(repogpt_llm_latency_seconds_bucket[5m])) by (le))",
          "legendFormat": "p50 Latency",
          "refId": "B"
        }
      ]
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "axisCenteredZero": false },
          "unit": "short"
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 1 },
      "id": 3,
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" }
      },
      "title": "LLM Tokens Consumed / Generated",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum(rate(repogpt_llm_tokens_total[5m])) by (direction)",
          "legendFormat": "Tokens ({{direction}})",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "axisCenteredZero": false },
          "unit": "s"
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 9 },
      "id": 4,
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" }
      },
      "title": "Retrieval Latency by Strategy",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum(rate(repogpt_retrieval_latency_seconds_sum[5m])) by (strategy) / sum(rate(repogpt_retrieval_latency_seconds_count[5m])) by (strategy)",
          "legendFormat": "Strategy: {{strategy}}",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "unit": "short"
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 9 },
      "id": 5,
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" }
      },
      "title": "Ingestion & Job Execution Counts",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum(rate(repogpt_job_duration_seconds_count[5m])) by (type, status)",
          "legendFormat": "Job: {{type}} ({{status}})",
          "refId": "A"
        }
      ]
    }
  ],
  "refresh": "10s",
  "schemaVersion": 38,
  "style": "dark",
  "tags": ["repogpt", "telemetry"],
  "time": {
    "from": "now-1h",
    "to": "now"
